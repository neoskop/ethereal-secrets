{
  "name": "@neoskop/ethereal-secrets-middleware",
  "version": "5.0.2",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "author": "Arne Diekmann <diekmann@neoskop.de>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">= 12.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neoskop/ethereal-secrets.git",
    "directory": "middleware"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "tsc": "tsc -p .",
    "build": "npm run clean; npm run tsc",
    "start": "jest --watchAll --runInBand",
    "test": "jest --runInBand --coverage"
  },
  "devDependencies": {
    "@types/body-parser": "1.19.6",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/jest": "30.0.0",
    "@types/validator": "13.15.10",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "body-parser": "2.4.0",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "ioredis": "6.0.0",
    "validator": "13.15.35"
  },
  "jest": {
    "preset": "ts-jest",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/src/test/**/*.ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "coverageProvider": "v8",
    "coverageDirectory": "./coverage",
    "coverageReporters": [
      "lcov",
      "text-summary"
    ],
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/test/**"
    ]
  }
}
