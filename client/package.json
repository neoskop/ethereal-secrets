{
  "name": "@neoskop/ethereal-secrets-client",
  "version": "5.0.2",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "author": "Arne Diekmann <diekmann@neoskop.de>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "tsc": "tsc -p .",
    "build": "npm run clean; npm run tsc",
    "start": "jest --watchAll",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">= 16.15.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      ".+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./test/setup.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neoskop/ethereal-secrets.git",
    "directory": "client"
  }
}
